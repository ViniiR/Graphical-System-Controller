<?xml version="1.0" encoding="UTF-8"?>
<interface domain="com.vinii.vgsc">
    <requires lib="gtk" version="4.20"/>

    <object class="GtkAdjustment" id="brightness-adjustment">
        <property name="lower">0.0</property>
        <property name="upper">100.0</property>
        <property name="step-increment">1.0</property>
        <property name="page-increment">10.0</property>
        <property name="value">0.0</property>
    </object>
    <object class="GtkAdjustment" id="volume-adjustment">
        <property name="lower">0.0</property>
        <property name="upper">100.0</property>
        <property name="step-increment">1.0</property>
        <property name="page-increment">10.0</property>
        <property name="value">0.0</property>
    </object>

    <object class="GtkApplicationWindow" id="main-window">
        <property name="default-width">200</property>
        <property name="default-height">400</property>

        <style>
            <class name="main-window"/>
        </style>

        <child> 
        <object class="GtkGrid" id="main-grid">
            <property name="column-spacing">10</property>
            <property name="row-spacing">10</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="column-homogeneous">True</property>

            <style>
                <class name="main-grid"/>
            </style>

            <child>
            <object class="GtkBox">
                <layout>
                    <property name="column">0</property>
                    <property name="row">0</property>
                    <property name="column-span">4</property>
                    <property name="row-span">1</property>
                </layout>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>

                <style>
                    <class name="top-box"/>
                </style>

                <child>
                <object class="GtkButton" id="battery-button">
                    <style>
                        <class name="battery-button"/>
                    </style>

                    <child>
                    <object class="GtkBox">
                        <property name="spacing">6</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>

                        <child>
                        <object class="GtkLabel" id="battery-button-box-label">
                            <property name="label">0%</property>
                        </object>
                        </child>
                        <child>
                        <object class="GtkImage" id="battery-button-box-image">
                            <property name="icon-name">battery-level-0</property>
                        </object>
                        </child>
                    </object>
                    </child>
                </object>
                </child>
                <child>
                <object class="GtkBox">
                    <property name="hexpand">true</property>
                </object>
                </child>
                <child>
                <object class="GtkButton" id="logout-button">
                    <property name="icon-name">system-log-out-symbolic</property>

                    <style>
                        <class name="power-button"/>
                    </style>

                </object>
                </child>
                <child>
                <object class="GtkButton" id="reboot-button">
                    <property name="icon-name">system-reboot-symbolic</property>

                    <style>
                        <class name="power-button"/>
                    </style>

                </object>
                </child>
                <child>
                <object class="GtkButton" id="shutdown-button">
                    <property name="icon-name">system-shutdown-symbolic</property>

                    <style>
                        <class name="power-button"/>
                    </style>

                </object>
                </child>
            </object>
            </child>

            <child>
            <object class="GtkBox">
                <layout>
                    <property name="column">0</property>
                    <property name="row">1</property>
                    <property name="column-span">1</property>
                    <property name="row-span">1</property>
                </layout>
                <property name="orientation">horizontal</property>
                <property name="spacing">10</property>
                <property name="halign">center</property>
                <property name="valign">center</property>

                <child>
                <object class="GtkImage" id="brightness-scale-label-image">
                    <property name="icon-name">display-brightness-medium-symbolic</property>
                </object>
                </child>
                <child> 
                <object class="GtkLabel" id="brightness-scale-label">
                    <property name="label">0</property>
                    <property name="selectable">False</property>

                    <style>
                        <class name="scale-label"/>
                    </style>

                </object>
                </child>
            </object>
            </child>
            <child> 
            <object class="GtkScale" id="brightness-scale">
                <property name="adjustment">brightness-adjustment</property>
                <property name="round-digits">0</property>
                <layout>
                    <property name="column">1</property>
                    <property name="row">1</property>
                    <property name="column-span">3</property>
                    <property name="row-span">1</property>
                </layout>

                <style>
                    <class name="scale"/>
                </style>

            </object>
            </child>

            <child>
            <object class="GtkBox" id="volume-scale-label-box">
                <layout>
                    <property name="column">0</property>
                    <property name="row">2</property>
                    <property name="column-span">1</property>
                    <property name="row-span">1</property>
                </layout>
                <property name="orientation">horizontal</property>
                <property name="spacing">10</property>
                <property name="halign">center</property>
                <property name="valign">center</property>

                <child>
                <object class="GtkImage" id="volume-scale-label-image">
                    <property name="icon-name">audio-status-volume-high-symbolic</property>
                </object>
                </child>
                <child> 
                <object class="GtkLabel" id="volume-scale-label">
                    <property name="label">0</property>
                    <property name="selectable">False</property>

                    <style>
                        <class name="scale-label"/>
                    </style>

                </object>
                </child>
            </object>
            </child>
            <child> 
            <object class="GtkScale" id="volume-scale">
                <property name="adjustment">volume-adjustment</property>
                <property name="round-digits">0</property>
                <layout>
                    <property name="column">1</property>
                    <property name="row">2</property>
                    <property name="column-span">3</property>
                    <property name="row-span">1</property>
                </layout>

                <style>
                    <class name="scale"/>
                </style>

            </object>
            </child>

            <child>
            <object class="GtkExpander" id="individual-audio-expander">
                <layout>
                    <property name="column">0</property>
                    <property name="row">3</property>
                    <property name="column-span">4</property>
                    <property name="row-span">1</property>
                </layout>

                <style>
                    <class name="expander-list"/>
                </style>

                <child>
                <object class="GtkListView" id="individual-audio-list">
                </object>
                </child>
            </object>
            </child>

            <!-- <child> -->
            <!-- <object class="GtkButton" id="wifi-dropdown"> -->
            <!--     <property name="label">Wi-Fi dropdown</property> -->
            <!--     <layout> -->
            <!--         <property name="column">0</property> -->
            <!--         <property name="row">4</property> -->
            <!--         <property name="column-span">2</property> -->
            <!--         <property name="row-span">1</property> -->
            <!--     </layout> -->
            <!---->
            <!--     <style> -->
            <!--         <class name="unused"/> -->
            <!--     </style> -->
            <!---->
            <!-- </object> -->
            <!-- </child> -->
            <!-- <child> -->
            <!-- <object class="GtkButton" id="bluetooth-select"> -->
            <!--     <property name="label">Bluetooth dropdown</property> -->
            <!--     <layout> -->
            <!--         <property name="column">2</property> -->
            <!--         <property name="row">4</property> -->
            <!--         <property name="column-span">2</property> -->
            <!--         <property name="row-span">1</property> -->
            <!--     </layout> -->
            <!---->
            <!--     <style> -->
            <!--         <class name="unused"/> -->
            <!--     </style> -->
            <!---->
            <!-- </object> -->
            <!-- </child> -->

            <child>
            <object class="GtkButton" id="conservation-mode-button">
                <layout>
                    <property name="column">0</property>
                    <property name="row">4</property>
                    <property name="column-span">2</property>
                    <property name="row-span">1</property>
                </layout>

                <style>
                    <class name="button"/>
                </style>

                <child>
                <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">10</property>
                    <property name="halign">start</property>
                    <property name="valign">center</property>

                    <style>
                        <class name="button-box"/>
                    </style>

                    <child>
                    <object class="GtkImage" id="conservation-mode-button-image">
                        <property name="icon-name">power-profile-power-saver-symbolic</property>
                    </object>
                    </child>
                    <child>
                    <object class="GtkLabel" id="conservation-mode-button-label">
                        <property name="label">Conservation</property>
                    </object>
                    </child>
                </object>
                </child>
            </object>
            </child>
            <child>
            <object class="GtkButton" id="power-mode-button">
                <property name="label">Power</property>
                <layout>
                    <property name="column">2</property>
                    <property name="row">4</property>
                    <property name="column-span">2</property>
                    <property name="row-span">1</property>
                </layout>

                <style>
                    <class name="button"/>
                    <class name="unused"/>
                </style>

            </object>
            </child>

            <child>
            <object class="GtkButton" id="boost-mode-button">
                <property name="label">Boost</property>
                <layout>
                    <property name="column">0</property>
                    <property name="row">5</property>
                    <property name="column-span">2</property>
                    <property name="row-span">1</property>
                </layout>

                <style>
                    <class name="button"/>
                </style>

                <child>
                <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">10</property>
                    <property name="halign">start</property>
                    <property name="valign">center</property>

                    <style>
                        <class name="button-box"/>
                    </style>

                    <child>
                    <object class="GtkImage" id="boost-mode-button-image">
                        <property name="icon-name">power-profile-performance-symbolic</property>
                    </object>
                    </child>
                    <child>
                    <object class="GtkLabel" id="boost-mode-button-label">
                        <property name="label">Boost</property>
                    </object>
                    </child>
                </object>
                </child>
            </object>
            </child>

        </object>
        </child>
    </object>
</interface>
