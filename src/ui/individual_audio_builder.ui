<?xml version="1.0" encoding="UTF-8"?>
<interface domain="com.vinii.vgsc">
    <requires lib="gtk" version="4.20"/>

    <object class="GtkAdjustment" id="volume-adjustment">
        <property name="lower">0.0</property>
        <property name="upper">100.0</property>
        <property name="step-increment">1.0</property>
        <property name="page-increment">10.0</property>
        <property name="value">0.0</property>
    </object>

    <object class="GtkGrid" id="main-grid">
        <property name="column-spacing">10</property>
        <property name="row-spacing">10</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="column-homogeneous">True</property>

        <child>
        <object class="GtkImage" id="stream-icon">
            <layout>
                <property name="column">0</property>
                <property name="row">0</property>
                <property name="column-span">1</property>
                <property name="row-span">1</property>
            </layout>
            <property name="icon-name">audio-card-symbolic</property>
        </object>
        </child>
        <child>
        <object class="GtkLabel" id="stream-name-label">
            <layout>
                <property name="column">1</property>
                <property name="row">0</property>
                <property name="column-span">3</property>
                <property name="row-span">1</property>
            </layout>
            <property name="label">Stream</property>
            <property name="halign">start</property>
            <property name="ellipsize">3</property>
        </object>
        </child>

        <child>
        <object class="GtkBox">
            <layout>
                <property name="column">0</property>
                <property name="row">1</property>
                <property name="column-span">1</property>
                <property name="row-span">1</property>
            </layout>
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="halign">center</property>
            <property name="valign">center</property>

            <child>
            <object class="GtkImage">
                <property name="icon-name">audio-volume-high-symbolic</property>
            </object>
            </child>
            <child> 
            <object class="GtkLabel">
                <property name="label">0</property>
                <property name="selectable">False</property>

                <style>
                    <class name="scale-label"/>
                </style>

            </object>
            </child>
        </object>
        </child>
        <child>
        <object class="GtkScale">
            <layout>
                <property name="column">1</property>
                <property name="row">1</property>
                <property name="column-span">3</property>
                <property name="row-span">1</property>
            </layout>
            <property name="adjustment">volume-adjustment</property>
            <property name="round-digits">0</property>

            <style>
                <class name="scale"/>
            </style>

        </object>
        </child>

    </object>
</interface>
